# Droitwich United Charities website – send every request to index.php
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS once you have an SSL certificate (cPanel > SSL/TLS Status > AutoSSL). Remove the # on the next 2 lines.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteRule ^(app|duc-data)(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "\.(json|log|txt|lock|md)$">
  Require all denied
</FilesMatch>
